# ── Required ─────────────────────────────────────────────────────────────────
# JWT signing secret. MUST be at least 32 characters. Never reuse in production.
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── Optional ─────────────────────────────────────────────────────────────────
# Port the server listens on (default: 3000)
PORT=3000
# development | production
NODE_ENV=development
# Telegram order notifications (leave blank to disable — orders still work)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# In production, restrict CORS to this origin (e.g. https://salemarket.uz)
ALLOWED_ORIGIN=
