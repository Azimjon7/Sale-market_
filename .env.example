# ── Required ─────────────────────────────────────────────────────────────────
# JWT signing secret. MUST be at least 32 characters. Never reuse in production.
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── Optional ─────────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Keep this only for local development.
PORT=3000
# development | production
NODE_ENV=development
# Public writes stay locked when this example is copied, including in development.
# Production also defaults to locked when this variable is absent.
# Explicitly set true only for the approved public launch or intentional local testing.
PUBLIC_WRITES_ENABLED=false
# Telegram order notifications (leave blank to disable — orders still work)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Production: https://dodola.uz
ALLOWED_ORIGIN=https://dodola.uz
# Customer cookie signing secret. Use a different random value of at least 32 characters.
CUSTOMER_SESSION_SECRET=change-this-to-another-long-random-string-min-32-chars
# Resend transactional email. Keep the real API key only in the server environment.
RESEND_API_KEY=re_your_server_side_api_key
# Public origin used in verification and password-reset links. No trailing slash.
AUTH_BASE_URL=https://dodola.uz
# Production after dodola.uz is verified in Resend.
EMAIL_FROM=Dodola <xatlar@dodola.uz>
# Only required while using Dodola <onboarding@resend.dev> in a test environment.
RESEND_TEST_RECIPIENT=
# Recommended durable production storage; customer JSON storage is local-development only.
DATABASE_URL=postgresql://user:password@host.example/neondb?sslmode=require
# Neon requires TLS. Use verify-full when a trusted CA chain is available.
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# Keep JSON active until the tested cutover is explicitly approved.
STORAGE_BACKEND=json
# One-shot safety gates. Leave disabled during normal server operation.
ALLOW_POSTGRES_IMPORT=no
ALLOW_POSTGRES_ROLLBACK=no

# Product/static file storage. Keep local until the R2 migration and cutover are approved.
FILE_STORAGE_BACKEND=local
# Cloudflare account ID and server-side S3 credentials. Never expose these to browser code.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Use separate public and private buckets so payment proofs can never be public.
R2_BUCKET_NAME=dodola-public-assets
R2_PRIVATE_BUCKET_NAME=dodola-private-uploads
# Production delivery domain attached to the public bucket. Do not use credentials in this URL.
R2_PUBLIC_BASE_URL=https://media.dodola.uz
# Optional; derived from R2_ACCOUNT_ID when omitted.
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# One-time migration safety gate. Keep disabled until the upload is explicitly approved.
R2_MIGRATION_APPROVED=no
